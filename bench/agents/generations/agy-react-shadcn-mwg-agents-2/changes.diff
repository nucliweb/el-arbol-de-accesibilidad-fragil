+    padding: 0 !important;
+    border: 0 !important;
+    white-space: nowrap !important;
+  }
+
+  .ringtone-radio + .ringtone-label {
+    position: relative;
+    padding-inline-start: 2rem;
+    display: inline-flex;
+    align-items: center;
+  }
+
+  .ringtone-radio + .ringtone-label::before {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0;
+    inset-block-start: 50%;
