+
+/* Accessible visually hidden utility (keeps element in accessibility tree) */
+.visually-hidden:where(:not(:focus-within, :active)) {
+  position: absolute !important;
+  clip-path: inset(50%) !important;
+  overflow: hidden !important;
+  width: 1px !important;
+  height: 1px !important;
+  margin: -1px !important;
+  padding: 0 !important;
+  border: 0 !important;
+  white-space: nowrap !important;
+}
+
+/* Native radio ringtone selector with Baseline Widely available fallback */
+.ringtone-option {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  min-block-size: 3rem;
+  padding-inline: 0.875rem;
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--border);
+  background-color: var(--card);
+  transition: border-color 150ms ease, background-color 150ms ease;
+}
+
+.ringtone-option:hover {
+  background-color: var(--muted);
+}
+
+.ringtone-option[data-selected="true"] {
+  border-color: var(--foreground);
+  background-color: var(--muted);
+}
+
+.ringtone-radio {
+  flex-shrink: 0;
+  inline-size: 1.25rem;
+  block-size: 1.25rem;
+  margin: 0;
+  accent-color: var(--primary);
+  cursor: pointer;
+}
+
+.ringtone-radio:focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 3px;
+}
+
+.ringtone-label {
+  display: flex;
+  flex: 1;
+  align-items: center;
+  min-block-size: 3rem;
+  padding-block: 0.625rem;
+  font: inherit;
+  font-size: max(1rem, 1em);
+  line-height: 1.4;
+  font-weight: 500;
+  cursor: pointer;
+  user-select: none;
+}
+
+@media (pointer: coarse) {
+  .ringtone-option,
+  .ringtone-label {
+    min-block-size: 3.25rem;
+  }
+}
+
+/* Fallback for browsers without accent-color support (Baseline Widely available) */
+@supports not (accent-color: auto) {
+  .ringtone-radio {
+    position: absolute !important;
+    clip-path: inset(50%) !important;
+    overflow: hidden !important;
+    width: 1px !important;
+    height: 1px !important;
+    margin: -1px !important;
+    padding: 0 !important;
+    border: 0 !important;
+    white-space: nowrap !important;
+  }
+
+  .ringtone-label {
+    position: relative;
+    padding-inline-start: 2rem;
+  }
+
+  .ringtone-radio + .ringtone-label::before {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0;
+    inset-block-start: 50%;
+    transform: translateY(-50%);
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    border: 2px solid var(--muted-foreground);
+    border-radius: 9999px;
+    background-color: var(--background);
+    box-sizing: border-box;
+    transition: border-color 150ms ease, background-color 150ms ease;
+  }
+
+  .ringtone-radio:focus-visible + .ringtone-label::before {
+    outline: 2px solid var(--foreground);
+    outline-offset: 3px;
+  }
+
+  .ringtone-radio:checked + .ringtone-label::before {
+    border-color: var(--primary);
+  }
+
+  .ringtone-radio:checked + .ringtone-label::after {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0.3125rem;
+    inset-block-start: 50%;
+    transform: translateY(-50%);
+    inline-size: 0.625rem;
+    block-size: 0.625rem;
+    border-radius: 9999px;
+    background-color: var(--primary);
+  }
+}
+
+@media (forced-colors: active) {
+  .ringtone-option[data-selected="true"] {
+    border-color: Highlight;
+  }
+
+  .ringtone-radio:focus-visible,
+  .ringtone-radio:focus-visible + .ringtone-label::before {
+    outline: 2px solid Highlight;
+    outline-offset: 3px;
+  }
+}
