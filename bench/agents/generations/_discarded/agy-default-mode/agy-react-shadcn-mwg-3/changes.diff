+  font: inherit;
+  font-size: max(1rem, 1em);
+  line-height: 1.4;
+  color: var(--foreground);
+  cursor: pointer;
+}
+
+.ringtone-label-text {
+  font-weight: 500;
+}
+
+.ringtone-badge {
+  display: inline-flex;
+  align-items: center;
+  padding-inline: 0.5rem;
+  padding-block: 0.125rem;
+  border: 1px solid var(--input);
+  border-radius: 9999px;
+  font-size: 0.75rem;
+  font-weight: 500;
+  line-height: 1.25;
+  color: var(--foreground);
+  background-color: var(--background);
+}
+
+.ringtone-preview-btn {
+  min-block-size: 2.75rem;
+  padding-inline: 0.75rem;
+  border-color: var(--input);
+}
+
+@media (pointer: coarse) {
+  .ringtone-option,
+  .ringtone-choice,
+  .ringtone-label,
+  .ringtone-preview-btn {
+    min-block-size: 3.25rem;
+  }
+}
+
+/* Fallback for older browsers without accent-color support */
+@supports not (accent-color: auto) {
+  .ringtone-radio {
+    position: absolute !important;
+    clip-path: inset(50%) !important;
+    overflow: hidden !important;
+    width: 1px !important;
+    height: 1px !important;
+    margin: -1px !important;
+    padding: 0 !important;
+    border: 0 !important;
+    white-space: nowrap !important;
+  }
+
+  .ringtone-label {
+    position: relative;
+    padding-inline-start: 2rem;
+  }
+
+  .ringtone-radio + .ringtone-label::before {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0;
+    inset-block-start: 50%;
+    transform: translateY(-50%);
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    border: 2px solid var(--input);
+    border-radius: 9999px;
+    background-color: var(--background);
+    box-sizing: border-box;
+  }
+
+  .ringtone-radio:checked + .ringtone-label::before {
+    border-color: var(--primary);
+  }
+
+  .ringtone-radio:checked + .ringtone-label::after {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0.3125rem;
+    inset-block-start: 50%;
+    transform: translateY(-50%);
+    inline-size: 0.625rem;
+    block-size: 0.625rem;
+    border-radius: 9999px;
+    background-color: var(--primary);
+  }
+
+  .ringtone-radio:focus-visible + .ringtone-label::before {
+    outline: 2px solid var(--foreground);
+    outline-offset: 2px;
+  }
+}
+
+/* Forced Colors Mode (Windows High Contrast) support */
+@media (forced-colors: active) {
+  [data-slot="card"] {
+    border: 1px solid CanvasText;
+  }
+
+  .ringtone-option {
+    border: 1px solid CanvasText;
+  }
+
+  .ringtone-option[data-selected="true"] {
+    border: 2px solid Highlight;
+    box-shadow: none;
+  }
+
+  .ringtone-badge {
+    border-color: CanvasText;
+  }
+
+  :is(a, button, input):focus-visible {
+    outline: 2px solid Highlight !important;
+    outline-offset: 2px !important;
+  }
+}
