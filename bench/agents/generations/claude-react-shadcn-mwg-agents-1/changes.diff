+}
+/* Fallback de marca para radios cuando accent-color no está soportado */
+@supports not (accent-color: auto) {
+  .ringtone-radio {
+    appearance: none;
+    display: inline-grid;
+    place-content: center;
+    border: 2px solid var(--muted-foreground);
+    border-radius: 50%;
+    background: var(--background);
+  }
+
+  .ringtone-radio::before {
+    content: "";
+    width: 0.5rem;
+    height: 0.5rem;
+    border-radius: 50%;
+    background: var(--primary);
+    transform: scale(0);
+  }
+
+  .ringtone-radio:checked {
+    border-color: var(--primary);
+  }
+
+  .ringtone-radio:checked::before {
+    transform: scale(1);
+  }
+
+  .ringtone-radio:focus-visible {
+    outline: 2px solid var(--ring);
+    outline-offset: 2px;
+  }
+}
