+        <div className="grid gap-2">
+          <Label htmlFor="email">Correo electrónico</Label>
+          <Input id="email" type="email" defaultValue="ada@example.com" />
+        </div>
+      </CardContent>
+      <CardFooter>
+        <Button>Guardar</Button>
+      </CardFooter>
+    </Card>
+  )
+}
 
