+  border-radius: var(--radius-lg);
+  background-color: var(--card);
+  transition: border-color 150ms ease, background-color 150ms ease;
+}
+
+.ringtone-option:has(.ringtone-radio:checked) {
+  border-color: var(--primary);
+  background-color: var(--muted);
+}
+
+.ringtone-radio {
+  flex-shrink: 0;
+  inline-size: 1.125rem;
+  block-size: 1.125rem;
+  margin: 0;
+  accent-color: var(--primary);
+  cursor: pointer;
+}
+
+.ringtone-radio:focus-visible {
+  outline: 3px solid var(--primary);
+  outline-offset: 2px;
+}
+
+.ringtone-label {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  min-block-size: 48px;
+  padding-block: 0.625rem;
+  font: inherit;
+  font-size: max(1rem, 1em);
+  line-height: 1.4;
+  font-weight: 500;
+  color: var(--foreground);
+  cursor: pointer;
+  user-select: none;
+}
+
+.form-control {
+  font: inherit;
+  font-size: max(1rem, 1em);
+  min-block-size: 48px;
+  border-color: var(--muted-foreground);
+}
+
+.form-control:focus-visible {
+  outline: 3px solid var(--primary);
+  outline-offset: 2px;
+}
+
+@media (pointer: coarse) {
+  .ringtone-option,
+  .ringtone-label,
+  .form-control {
+    min-block-size: 52px;
+  }
+}
+
+/* Fallback for browsers without accent-color support */
+@supports not (accent-color: auto) {
+  .ringtone-radio {
+    position: absolute !important;
+    clip-path: inset(50%) !important;
+    overflow: hidden !important;
+    width: 1px !important;
+    height: 1px !important;
+    margin: -1px !important;
+    padding: 0 !important;
+    border: 0 !important;
+    white-space: nowrap !important;
+  }
+
+  .ringtone-option {
+    gap: 0;
+  }
+
+  .ringtone-radio + .ringtone-label {
+    position: relative;
+    padding-inline-start: 2rem;
+  }
+
+  .ringtone-radio + .ringtone-label::before {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0;
+    inset-block-start: 50%;
+    transform: translateY(-50%);
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    border: 2px solid var(--muted-foreground);
+    border-radius: 9999px;
+    background: var(--background);
+    box-sizing: border-box;
+  }
+
+  .ringtone-radio:focus-visible + .ringtone-label::before {
+    outline: 3px solid var(--primary);
+    outline-offset: 2px;
+  }
+
+  .ringtone-radio:checked + .ringtone-label::before {
+    border-color: var(--primary);
+  }
+
+  .ringtone-radio:checked + .ringtone-label::after {
+    content: "";
+    position: absolute;
+    inset-inline-start: 0.3125rem;
+    inset-block-start: 50%;
