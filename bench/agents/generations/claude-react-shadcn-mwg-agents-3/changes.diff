+function subscribeToHash(callback: () => void) {
+  window.addEventListener('hashchange', callback)
+  return () => window.removeEventListener('hashchange', callback)
+}
+
+function useHash() {
+  return useSyncExternalStore(subscribeToHash, () => window.location.hash)
+}
